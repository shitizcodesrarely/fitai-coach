generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  password      String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Profile
  age           Int?
  weightKg      Float?
  heightCm      Float?
  goal          String?
  experience    String?
  daysPerWeek   Int?
  equipment     String?

  // Avatar
  avatarData    String?   // JSON string: { type, bodyType, ... } or { type: "legend", name: "cbum" }
  theme         String?   @default("arctic")

  // Relations
  workoutPlans    WorkoutPlan[]
  sessions        WorkoutSession[]
  bodyMetrics     BodyMetric[]
  formChecks      FormCheck[]
  userStats       UserStats?
  userBadges      UserBadge[]
  friendsAdded    Friend[]  @relation("UserFriends")
  friendsOf       Friend[]  @relation("FriendOf")

  @@index([email])
}

model WorkoutPlan {
  id          String    @id @default(cuid())
  userId      String
  title       String
  weekNumber  Int       @default(1)
  planData    String    // JSON stored as string for SQLite
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions    WorkoutSession[]

  @@index([userId])
}

model WorkoutSession {
  id            String    @id @default(cuid())
  userId        String
  planId        String?
  dayLabel      String
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  durationMins  Int?
  notes         String?
  totalVolumeKg Float?    @default(0)
  xpEarned      Int?      @default(0)

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan          WorkoutPlan?    @relation(fields: [planId], references: [id])
  logs          SessionLog[]

  @@index([userId])
  @@index([startedAt])
}

model SessionLog {
  id          String    @id @default(cuid())
  sessionId   String
  exercise    String
  setNumber   Int
  reps        Int
  weightKg    Float
  rpe         Int?
  isPersonalBest Boolean @default(false)
  loggedAt    DateTime  @default(now())

  session     WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([exercise])
}

model BodyMetric {
  id          String    @id @default(cuid())
  userId      String
  weightKg    Float?
  bodyFatPct  Float?
  notes       String?
  loggedAt    DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([loggedAt])
}

model FormCheck {
  id           String    @id @default(cuid())
  userId       String
  exercise     String
  videoUrl     String
  thumbnailUrl String?
  status       String    @default("PENDING")
  aiFeedback   String?
  createdAt    DateTime  @default(now())

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ── Gamification ─────────────────────────────────────────────────────────────

model UserStats {
  id                String    @id @default(cuid())
  userId            String    @unique
  xp                Int       @default(0)
  level             Int       @default(1)
  totalVolumeKg     Float     @default(0)
  totalSessions     Int       @default(0)
  currentStreak     Int       @default(0)
  longestStreak     Int       @default(0)
  lastWorkoutDate   String?   // stored as YYYY-MM-DD string
  weeklyVolume      Float     @default(0)
  weeklySessionCount Int      @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Badge {
  id          String      @id @default(cuid())
  key         String      @unique  // e.g. "baptism_of_iron"
  name        String               // e.g. "Baptism of Iron"
  description String
  universe    String               // e.g. "Warhammer 40K"
  icon        String               // emoji or icon name
  xpReward    Int         @default(50)

  userBadges  UserBadge[]
}

model UserBadge {
  id        String    @id @default(cuid())
  userId    String
  badgeId   String
  earnedAt  DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge     Badge     @relation(fields: [badgeId], references: [id])

  @@unique([userId, badgeId])
  @@index([userId])
}

model Friend {
  id          String    @id @default(cuid())
  userId      String
  friendId    String
  createdAt   DateTime  @default(now())

  user        User      @relation("UserFriends", fields: [userId], references: [id], onDelete: Cascade)
  friend      User      @relation("FriendOf", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId])
  @@index([userId])
}

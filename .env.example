# ── App ────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET=your_nextauth_secret_change_this
NEXTAUTH_URL=http://localhost:3000

# ── Database ───────────────────────────────────────────────────────────
# LOCAL DEV — SQLite (no setup needed)
DATABASE_URL="file:./dev.db"

# PRODUCTION — uncomment and fill when deploying to AWS RDS
# DATABASE_URL="mysql://USER:PASSWORD@your-rds-endpoint.rds.amazonaws.com:3306/fitai"

# ── Redis (AWS ElastiCache in prod, local Redis in dev) ────────────────
REDIS_URL=redis://localhost:6379

# ── Anthropic Claude API ───────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── AWS (fill when doing Week 4 deployment) ────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_S3_BUCKET_NAME=fitai-coach-uploads
AWS_CLOUDFRONT_URL=https://your-cloudfront-id.cloudfront.net
AWS_SES_FROM_EMAIL=noreply@yourdomain.com
